# Streamlit auth configuration for Google OIDC login.
#
# Copy this file to `.streamlit/secrets.toml` and fill in the values below.
# The actual `secrets.toml` is gitignored — never commit it.
#
# When deploying to Streamlit Community Cloud, paste this same content into
# the app's Secrets editor in the Cloud dashboard.

[auth]
# Where Google redirects after login. Must EXACTLY match the "Authorized
# redirect URI" you set in Google Cloud Console.
#   - Local dev:           "http://localhost:8501/oauth2callback"
#   - Streamlit Cloud:     "https://<your-app>.streamlit.app/oauth2callback"
redirect_uri = "http://localhost:8501/oauth2callback"

# Long random string used to sign the session cookie. Generate with e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
cookie_secret = "REPLACE_ME_WITH_A_LONG_RANDOM_STRING"

# These come from your Google Cloud Console OAuth 2.0 Client (Web app type).
client_id     = "REPLACE_ME.apps.googleusercontent.com"
client_secret = "REPLACE_ME"

# Standard Google discovery endpoint — leave as-is.
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
